+  font-size: 14px;
+  font-weight: 700;
+  letter-spacing: 0.5px;
+  margin-bottom: 14px;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.idx{
+  font-family:'JetBrains Mono';
+  font-size: 11px;
+  color: var(--dim);
+}
+
+.tags{ display:flex; flex-wrap:wrap; gap:8px; }
+
+.tag{
+  font-family:'JetBrains Mono'; font-size:11px; letter-spacing:0.5px;
+  border:1px solid var(--line); padding:7px 12px;
+  color:var(--white); transition: background 0.2s ease, color 0.2s ease;
+}
+.tag:hover{ background:var(--white); color:#000; }
+
+.explorations-visual{ display:flex; justify-content:center; position: sticky; top: 100px; }
+
+.frame{
+  position: relative;
+  width: 100%;
+  aspect-ratio: 4 / 5;
+  border: 1px solid var(--line);
+  overflow: hidden;
+}
+.frame img{
+  width:100%; height:100%; object-fit:cover;
+  filter: grayscale(100%) contrast(1.1);
+  transition: transform 0.6s cubic-bezier(.2,.7,.2,1);
+}
+.frame:hover img{ transform: scale(1.05); }
+
+.corner{ position:absolute; width:16px; height:16px; border:2px solid var(--white); z-index:2; }
+.corner.tl{ top:-1px; left:-1px; border-right:none; border-bottom:none; }
+.corner.tr{ top:-1px; right:-1px; border-left:none; border-bottom:none; }
+.corner.bl{ bottom:-1px; left:-1px; border-right:none; border-top:none; }
+.corner.br{ bottom:-1px; right:-1px; border-left:none; border-top:none; }
+
+.frame-tag{
+  position:absolute; top:12px; left:12px; z-index:2;
+  font-family:'JetBrains Mono'; font-size:10px; letter-spacing:1px;
+  color:var(--white); background:rgba(0,0,0,0.6); padding:4px 8px;
+}
+
+.reveal{ opacity:0; transform:translateY(24px); animation: revealUp 0.7s cubic-bezier(.2,.7,.2,1) forwards; }
+.r1{ animation-delay:0.1s; }
+.r2{ animation-delay:0.2s; }
+.r3{ animation-delay:0.3s; }
+.r4{ animation-delay:0.42s; }
+.r5{ animation-delay:0.54s; }
+
+@keyframes revealUp{ to{ opacity:1; transform:translateY(0); } }
+
+@media (max-width: 900px){
+  .explorations{ padding-top: 76px; align-items: flex-start; }
+  .explorations-grid{ grid-template-columns: 1fr; padding: 24px; gap: 28px; }
+  .explorations-visual{ order:-1; position: static; }
+  .frame{ aspect-ratio: 16/10; }
+}
