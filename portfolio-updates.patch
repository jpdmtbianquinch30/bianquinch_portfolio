+:host {
+  --white:#FFFFFF;
+  --dim:#6a6a6a;
+  --line:#2a2a2a;
+  display: block;
+}
+
+.contact{
+  min-height: 100vh;
+  padding-top: 76px;
+  display: flex;
+  flex-direction: column;
+}
+
+.contact-grid{
+  flex: 1;
+  display: grid;
+  grid-template-columns: 1.1fr 0.9fr;
+  align-items: center;
+  gap: 48px;
+  padding: 40px 48px;
+}
+
+.eyebrow{
+  font-family:'JetBrains Mono'; font-size:12px; color:var(--dim);
+  letter-spacing:2px; margin-bottom:16px;
+}
+
+.contact-main h1{
+  font-size: clamp(36px, 6.5vw, 72px);
+  font-weight:700; letter-spacing:-1.5px; margin-bottom: 16px;
+}
+
+.lead{ font-size:16px; color:var(--dim); margin-bottom: 32px; }
+
+.contact-list{ display:flex; flex-direction:column; }
+.contact-item{
+  display:flex; flex-direction:column; gap:6px;
+  padding: 18px 0; border-top: 1px solid var(--line);
+  text-decoration: none; color: var(--white);
+}
+.contact-list a.contact-item:hover .c-value{ text-decoration: underline; }
+.contact-item:last-child{ border-bottom: 1px solid var(--line); }
+
+.c-label{ font-family:'JetBrains Mono'; font-size:10px; color:var(--dim); letter-spacing:1px; }
+.c-value{ font-size:16px; font-weight:600; }
+
+.socials{ display:flex; flex-wrap:wrap; gap: 20px; margin-top: 28px; }
+.socials a{
+  font-family:'JetBrains Mono'; font-size:12px; letter-spacing:0.5px;
+  color: var(--dim); text-decoration:none; border-bottom: 1px solid transparent;
+  transition: color 0.2s ease, border-color 0.2s ease;
+}
+.socials a:hover{ color: var(--white); border-color: var(--white); }
+
+.contact-cta{ margin-top: 36px; }
+.btn-primary{
+  display:inline-block;
+  font-family:'JetBrains Mono'; font-size:12px; letter-spacing:0.5px;
+  padding: 15px 26px; text-decoration:none;
+  background: var(--white); color:#000; transition: all 0.2s ease;
+}
+.btn-primary:hover{ background: transparent; color: var(--white); border:1px solid var(--white); padding: 14px 25px; }
+
+.contact-visual{ display:flex; justify-content:center; }
+.frame{
+  position: relative; width: 100%; aspect-ratio: 4 / 5;
+  border: 1px solid var(--line); overflow: hidden;
+}
+.frame img{ width:100%; height:100%; object-fit:cover; filter: grayscale(100%) contrast(1.1); transition: transform 0.6s cubic-bezier(.2,.7,.2,1); }
+.frame:hover img{ transform: scale(1.05); }
+.corner{ position:absolute; width:16px; height:16px; border:2px solid var(--white); z-index:2; }
+.corner.tl{ top:-1px; left:-1px; border-right:none; border-bottom:none; }
+.corner.tr{ top:-1px; right:-1px; border-left:none; border-bottom:none; }
+.corner.bl{ bottom:-1px; left:-1px; border-right:none; border-top:none; }
+.corner.br{ bottom:-1px; right:-1px; border-left:none; border-top:none; }
+.frame-tag{
+  position:absolute; top:12px; left:12px; z-index:2;
+  font-family:'JetBrains Mono'; font-size:10px; letter-spacing:1px;
+  color:var(--white); background:rgba(0,0,0,0.6); padding:4px 8px;
+}
+
+.site-footer{
+  border-top: 1px solid var(--line);
+  padding: 20px 48px;
+  font-family:'JetBrains Mono'; font-size:11px; color:var(--dim);
+  text-align: center;
+}
+
+.reveal{ opacity:0; transform:translateY(24px); animation: revealUp 0.7s cubic-bezier(.2,.7,.2,1) forwards; }
+.r1{ animation-delay:0.1s; } .r2{ animation-delay:0.25s; } .r3{ animation-delay:0.4s; }
+.r4{ animation-delay:0.5s; } .r5{ animation-delay:0.6s; }
+@keyframes revealUp{ to{ opacity:1; transform:translateY(0); } }
+
+@media (max-width: 900px){
+  .contact-grid{ grid-template-columns: 1fr; padding: 24px; gap: 28px; }
+  .contact-visual{ order:-1; }
+  .frame{ aspect-ratio: 16/10; }
+  .site-footer{ padding: 20px; }
+}
